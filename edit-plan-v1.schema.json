{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MLT edit plan",
  "description": "Edit decisions generated from OBS markers. Source boundaries are authoritative timecodes or second offsets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "tail_policy", "segments", "annotations"],
  "properties": {
    "version": {"const": 1},
    "source": {"type": "string", "minLength": 1, "description": "Recording path, relative to this plan unless absolute."},
    "tail_policy": {"const": "discard"},
    "audio_file": {"type": "string", "minLength": 1, "description": "Optional replacement audio path, relative to this plan unless absolute."},
    "audio_stream": {"type": "integer", "minimum": 0},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/segment"}
    },
    "annotations": {
      "type": "array",
      "items": {"$ref": "#/definitions/annotation"}
    }
  },
  "definitions": {
    "timecode": {
      "type": "string",
      "pattern": "^[0-9]{2,}:[0-5][0-9]:[0-5][0-9](?::[0-9]{2,})?$",
      "description": "HH:MM:SS or HH:MM:SS:FF. Frame count is checked against the recording frame rate when rendering."
    },
    "position": {
      "oneOf": [
        {"$ref": "#/definitions/timecode"},
        {"type": "number", "minimum": 0}
      ],
      "description": "Source position as a timecode, or a fractional second offset."
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_start", "source_end", "keep"],
      "properties": {
        "source_start": {"$ref": "#/definitions/position"},
        "source_end": {"$ref": "#/definitions/position"},
        "keep": {"type": "boolean"},
        "marker": {"type": "string"},
        "join_after": {"enum": ["cut", "dissolve", null]},
        "transition_duration": {"type": "number", "exclusiveMinimum": 0, "description": "Dissolve length in seconds."}
      }
    },
    "annotation": {
      "type": "object",
      "required": ["time", "marker", "kind", "csv_row"],
      "properties": {
        "time": {"$ref": "#/definitions/position"},
        "marker": {"type": "string"},
        "kind": {"enum": ["point", "range"]},
        "csv_row": {"type": "integer", "minimum": 1},
        "end": {"$ref": "#/definitions/position"},
        "effect": {"type": "string"},
        "default_duration": {"type": "number", "minimum": 0},
        "role": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
